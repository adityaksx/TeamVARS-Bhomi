AI_PROVIDER=mock

# Sarvam: Document AI extraction + Sarvam 105B reasoning
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b
SARVAM_DIGITISE_ENABLED=false
SARVAM_DOCUMENT_LANGUAGE=hi-IN

# NVIDIA NIM: OpenAI-compatible cloud reasoning
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# Ollama: local reasoning, no API key
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# Legacy provider kept for compatibility
OPENMODEL_API_KEY=
OPENMODEL_BASE_URL=https://api.openmodel.ai
OPENMODEL_MODEL=

CORS_ORIGINS=http://localhost:3000

CASE_STORE_BACKEND=local
DATABASE_URL=

DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ENDPOINT_URL=
DOCUMENT_STORAGE_REGION=auto
DOCUMENT_STORAGE_ACCESS_KEY=
DOCUMENT_STORAGE_SECRET_KEY=

MAX_UPLOAD_MB=25
MAX_CASE_UPLOAD_MB=100
MAX_DOCUMENTS_PER_CASE=20
